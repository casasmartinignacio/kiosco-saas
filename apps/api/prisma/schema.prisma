generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  branches   Branch[]
  categories Category[]
  products   Product[]
}

model Branch {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  nextOrderNumber Int      @default(1042)
  idleSeconds     Int      @default(90)
  legalId         String   @default("")
  tradeName       String   @default("")
  cabysDefault    String   @default("")
  terminalUrl     String   @default("")
  printersJson    String   @default("[]")
  createdAt       DateTime @default(now())
  products        Product[]
  orders          Order[]
  terminals       Terminal[]
  staff           StaffUser[]
  customers       Customer[]
  promotions      Promotion[]
  ingredients     Ingredient[]
  shifts          RegisterShift[]
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  sortOrder Int
  products  Product[]
}

model Product {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  name        String
  description String          @default("")
  priceCrc    Int
  imageUrl    String
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  stock       Int?
  cabys       String          @default("")
  groups      ModifierGroup[]
  orderItems  OrderItem[]
  recipe      RecipeLine[]
  promotions  Promotion[]
}

model ModifierGroup {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  name      String
  selection String
  sortOrder Int              @default(0)
  options   ModifierOption[]
}

model ModifierOption {
  id                String        @id @default(cuid())
  groupId           String
  group             ModifierGroup @relation(fields: [groupId], references: [id])
  name              String
  priceCrc          Int           @default(0)
  sortOrder         Int           @default(0)
  selectedByDefault Boolean       @default(false)
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  number        Int
  status        String      @default("PENDING")
  paymentMethod String
  beeperNumber   String
  channel        String      @default("KIOSK")
  terminalName   String      @default("Kiosco 01")
  note           String      @default("")
  idempotencyKey String?
  receiptKind    String      @default("TICKET")
  customerName   String      @default("")
  customerTaxId  String      @default("")
  customerCode   String      @default("")
  invoiceStatus  String      @default("NOT_ISSUED")
  invoiceClave   String      @default("")
  invoiceNumber  String      @default("")
  invoiceDetail  String      @default("")
  discountCrc    Int         @default(0)
  promotionName  String      @default("")
  subtotalCrc    Int
  totalCrc       Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  pagerAlert     PagerAlert?

  @@unique([branchId, number])
  @@unique([branchId, idempotencyKey])
  @@index([branchId, status])
  @@index([branchId, beeperNumber])
  @@index([branchId, createdAt])
}

model Terminal {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  channel   String
  createdAt DateTime @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  action    String
  orderId   String?
  actorName String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
}

model PagerAlert {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  pagerCode String
  status    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model StaffUser {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name         String
  pin          String?
  email        String?
  passwordHash String   @default("")
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([branchId, pin])
  @@unique([branchId, email])
}

model Customer {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  code      String
  name      String
  phone     String   @default("")
  createdAt DateTime @default(now())

  @@unique([branchId, code])
}

model Promotion {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  kind      String
  value     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Ingredient {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id])
  name      String
  unit      String       @default("u")
  stock     Int          @default(0)
  recipe    RecipeLine[]
}

model RecipeLine {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Int

  @@unique([productId, ingredientId])
}

model RegisterShift {
  id              String    @id @default(cuid())
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id])
  terminalName    String
  openedBy        String
  closedBy        String    @default("")
  openingCashCrc  Int
  closingCashCrc  Int?
  expectedCashCrc Int?
  note            String    @default("")
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id])
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  name         String
  quantity     Int
  unitPriceCrc Int
  optionsLabel String  @default("")
  note         String  @default("")

  @@index([orderId])
}
